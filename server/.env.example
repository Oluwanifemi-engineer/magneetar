# ═══════════════════════════════════════════════════════════════════════════════
# MAGNEETAR SERVER — Environment Configuration
# Copy this file to .env and fill in your values.
# Generate secrets: ./scripts/generate-env.sh
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core Security (REQUIRED — server won't start without these) ───────────────
# API key for device registration (min 32 chars)
MT_API_KEY=
# JWT signing secret (min 64 chars)
MT_JWT_SECRET=
# AES-256 field encryption key (exactly 64 hex chars = 32 bytes)
MT_ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development default)
MT_DB_PATH=magneetar.db
# PostgreSQL (production — overrides SQLite when set)
# MT_DATABASE_URL=postgresql://magneetar:password@localhost:5432/magneetar

# ── Environment ───────────────────────────────────────────────────────────────
# "development" or "production" — controls CORS, logging, validation strictness
MT_ENVIRONMENT=development
MT_HOST=0.0.0.0
MT_PORT=8000
MT_LOG_LEVEL=info

# ── Limits ────────────────────────────────────────────────────────────────────
# Free-tier device allowance ("free forever · 1 device" on the pricing page).
# Paid tiers: Personal 3 / Guardian 10 / Enterprise 999 (see server/plans.py);
# per-tier overrides as JSON via MT_PLAN_LIMITS='{"personal": 3}'.
MT_MAX_DEVICES=1
MT_RETENTION_DAYS=90

# ── Payments — Paystack (required to sell subscriptions) ─────────────────────
# SECRET is used for checkout + signs webhooks (HMAC-SHA512). If you front
# Paystack with your own signing secret, set WEBHOOK_SECRET instead — the
# webhook FAILS CLOSED (503) when neither is set, by design.
# MT_PAYSTACK_SECRET=sk_live_xxx
# MT_PAYSTACK_WEBHOOK_SECRET=

# ── External command channels (all fail closed when unset) ───────────────────
# USSD gateway callback — shared secret the telco aggregator must present
# (form field `secret` or X-USSD-Secret header). Unset = endpoint returns 503.
# MT_USSD_WEBHOOK_SECRET=
# WhatsApp bot (Meta Cloud API): webhook verification + payload signatures.
# APP_SECRET is the Meta app secret (X-Hub-Signature-256 key);
# VERIFY_TOKEN is the token Meta echoes during the GET handshake.
# MT_WHATSAPP_APP_SECRET=
# MT_WHATSAPP_VERIFY_TOKEN=
# MT_WHATSAPP_ACCESS_TOKEN=
# MT_WHATSAPP_PHONE_NUMBER_ID=

# ── Alert Services (optional — configure for real alerts) ────────────────────
# Email alerts via SendGrid
# MT_SENDGRID_KEY=your-sendgrid-api-key
# MT_ALERT_EMAIL=you@example.com

# SMS alerts — Twilio (preferred, same account as WhatsApp)
# MT_TWILIO_SMS_FROM=+15551234567   # SMS-capable Twilio number
# (Fallback provider: Termii)
# MT_TERMII_KEY=your-termii-api-key
# MT_ALERT_PHONE=+234...             # phone that receives SMS/WhatsApp alerts

# WhatsApp alerts via Twilio
# MT_TWILIO_SID=your-twilio-sid       # must start with AC
# MT_TWILIO_AUTH_TOKEN=your-twilio-auth-token
# MT_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # sandbox; replace in production
# WhatsApp Content template for business-initiated alerts (theft, SIM change...)
# which arrive OUTSIDE the 24h window where free-form text is rejected.
# Find it in Twilio Console > Content > Templates (SID starts with HX).
# MT_TWILIO_WHATSAPP_TEMPLATE_SID=HX...
# JSON map of template placeholders {{1}}, {{2}}... to alert data keys.
# MT_TWILIO_WHATSAPP_TEMPLATE_VARIABLES={"1": "location", "2": "time", "3": "score"}

# Push notifications via Firebase Cloud Messaging
# MT_FIREBASE_KEY=path-to-firebase-credentials.json

# ── Monitoring (optional) ────────────────────────────────────────────────────
# MT_SENTRY_DSN=https://xxx@sentry.io/xxx
