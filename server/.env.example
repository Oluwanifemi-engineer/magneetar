# ═══════════════════════════════════════════════════════════════════════════════
# MAGNEETAR SERVER — Environment Configuration
# Copy this file to .env and fill in your values.
# Generate secrets: ./scripts/generate-env.sh
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core Security (REQUIRED — server won't start without these) ───────────────
# API key for device registration (min 32 chars)
MT_API_KEY=
# JWT signing secret (min 64 chars)
MT_JWT_SECRET=
# AES-256 field encryption key (exactly 64 hex chars = 32 bytes)
MT_ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development default)
MT_DB_PATH=magneetar.db
# PostgreSQL (production — overrides SQLite when set)
# MT_DATABASE_URL=postgresql://magneetar:password@localhost:5432/magneetar

# ── Environment ───────────────────────────────────────────────────────────────
# "development" or "production" — controls CORS, logging, validation strictness
MT_ENVIRONMENT=development
MT_HOST=0.0.0.0
MT_PORT=8000
MT_LOG_LEVEL=info

# ── Limits ────────────────────────────────────────────────────────────────────
MT_MAX_DEVICES=10
MT_RETENTION_DAYS=90

# ── Alert Services (optional — configure for real alerts) ────────────────────
# Email alerts via SendGrid
# MT_SENDGRID_KEY=your-sendgrid-api-key
# MT_ALERT_EMAIL=you@example.com

# SMS alerts — Twilio (preferred, same account as WhatsApp)
# MT_TWILIO_SMS_FROM=+15551234567   # SMS-capable Twilio number
# (Fallback provider: Termii)
# MT_TERMII_KEY=your-termii-api-key
# MT_ALERT_PHONE=+234...             # phone that receives SMS/WhatsApp alerts

# WhatsApp alerts via Twilio
# MT_TWILIO_SID=your-twilio-sid       # must start with AC
# MT_TWILIO_AUTH_TOKEN=your-twilio-auth-token
# MT_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # sandbox; replace in production

# Push notifications via Firebase Cloud Messaging
# MT_FIREBASE_KEY=path-to-firebase-credentials.json

# ── Monitoring (optional) ────────────────────────────────────────────────────
# MT_SENTRY_DSN=https://xxx@sentry.io/xxx
