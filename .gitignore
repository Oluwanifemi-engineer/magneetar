# ═══════════════════════════════════════════════════════════════════════════════
# MAGNEETAR — Git Ignore Rules
# ═══════════════════════════════════════════════════════════════════════════════

# ── Secrets (NEVER commit) ───────────────────────────────────────────────────
api.key
.env
.env.local
.env.production
server/.db_password

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
server/magneetar.db

# ── Python ────────────────────────────────────────────────────────────────────
server/venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# ── Android ───────────────────────────────────────────────────────────────────
android-app/.gradle/
android-app/app/build/
android-app/build/
*.keystore
*.jks
*.idsig
local.properties

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/

# ── Dashboard ─────────────────────────────────────────────────────────────────
dashboard/.next/
dashboard/out/
dashboard/dist/

# ── Large Binaries ────────────────────────────────────────────────────────────
*.deb
*.rpm
*.apk
*.aab

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Backups ───────────────────────────────────────────────────────────────────
backups/

# ── Build Artifacts ───────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Coverage ──────────────────────────────────────────────────────────────────
htmlcov/
.coverage
coverage/
server/firebase-key.json

# Firebase config — a placeholder is committed at
# android-app/app/google-services.json so CI builds succeed. It contains NO
# real secrets. To use real Firebase, replace that file with your real one
# (or inject it via the GOOGLE_SERVICES_JSON secret in GitHub Actions).
# NOTE: android-app/app/google-services.json is tracked by git; use
# `git update-index --skip-worktree` if you keep real credentials locally.
