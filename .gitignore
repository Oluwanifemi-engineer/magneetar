# ═══════════════════════════════════════════════════════════════════════════════
# MAGNEETAR — Git Ignore Rules
# ═══════════════════════════════════════════════════════════════════════════════

# ── Secrets (NEVER commit) ───────────────────────────────────────────────────
api.key
.env
.env.local
.env.production
server/.db_password

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
server/magneetar.db

# ── Python ────────────────────────────────────────────────────────────────────
server/venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# ── Android ───────────────────────────────────────────────────────────────────
android-app/.gradle/
android-app/app/build/
android-app/build/
*.keystore
# Lost-password keystore backup (private key material — never commit)
release.keystore.*
*.jks
*.idsig
local.properties

# ── iOS ────────────────────────────────────────────────────────────────────────
# Build-time config carries the LOW-PRIVILEGE device key — never commit.
ios-app/Config.xcconfig
# Firebase client config identifies the live project — never commit.
ios-app/**/GoogleService-Info.plist
# Generated by `xcodegen generate` — never commit.
ios-app/*.xcodeproj
ios-app/*.xcworkspace
# Xcode build output.
ios-app/DerivedData/
ios-app/build/

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/

# ── Dashboard ─────────────────────────────────────────────────────────────────
dashboard/.next/
dashboard/out/
dashboard/dist/
# Generated page output — prerendered HTML + RSC navigation payloads. `npm run
# build` (and the Docker image build) writes these into dashboard/out/ from
# dashboard/src. Hand-synced copies used to be committed under
# dashboard/public/ and silently drifted from the source, shipping retired
# marketing copy ("Military-grade / Sentinel AI / phantom mode") as extra,
# unreferenced files in the image. Never commit build output.
# robots.txt / sitemap.xml are likewise generated — from src/app/robots.ts and
# src/app/sitemap.ts — not from dashboard/public/.
dashboard/public/*.html
dashboard/public/*.txt

# ── Large Binaries ────────────────────────────────────────────────────────────
*.deb
*.rpm
*.apk
*.aab

# ── Build outputs that must never be committed ────────────────────────────────
# android-app/app/build/ and android-app/.gradle/ are covered by their own
# project-level ignores (android-app/.gitignore). This rule is a belt-and-
suspenders safety net for any APK/AAB that sneaks in elsewhere.
android-app/app/build/
android-app/.gradle/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Backups ───────────────────────────────────────────────────────────────────
backups/

# ── Evidence / user-media artifacts ───────────────────────────────────────────
# server/media/ holds generated evidence files (photos, PDFs, thumbnails).
# These are large binaries and MUST NOT enter git. They are regenerated from
# the application database / storage backend, not shipped as source.
server/media/

# ── Build Artifacts ───────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Coverage ──────────────────────────────────────────────────────────────────
htmlcov/
.coverage
coverage/
server/firebase-key.json
# Firebase service-account keys must never enter git, wherever they land.
**/firebase-service-account.json

# Firebase client config — the real file must NEVER be committed (it
# identifies the live Firebase project). A safe placeholder template is
# committed at android-app/app/google-services.json.example; CI injects the
# real file from the GOOGLE_SERVICES_JSON secret, local devs restore theirs
# from backups/google-services.json.real (or run the firebase setup script).
android-app/**/google-services.json
*.apk.bak*
*.apk.sideload*
*.aab

# Release source tarballs + staged APKs live on the server, never in git
# (build artifacts; the repo is private and the tarball is served from /apk/source).
server/static/apk/

# Real Kubernetes secrets — only the TEMPLATE (secrets.yml.example) is tracked.
kubernetes/secrets.yml
coverage.xml
