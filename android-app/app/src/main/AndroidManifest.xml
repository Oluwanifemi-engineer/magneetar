<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Find Network (BLE SOS beacon + guardian scanning). Bluetooth classic
         perms are required on API 24-30; the runtime BLUETOOTH_SCAN/
         BLUETOOTH_ADVERTISE pair supersedes them on API 31+. neverForLocation
         on ADVERTISE: the beacon carries an opaque token, not a position. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Wi-Fi RTT (802.11mc) indoor ranging (G1-17): ACCESS_WIFI_STATE and
         CHANGE_WIFI_STATE are normal install-time permissions; NEARBY_WIFI_DEVICES
         is a runtime permission on API 33+. It deliberately does NOT carry
         usesPermissionFlags="neverForLocation" — Magneetar derives physical
         location from Wi-Fi (the whole point of RTT), so the flag would be a
         policy lie and would break ranging on modern Android. RTT is OPTIONAL:
         a denied NEARBY_WIFI_DEVICES just means no 1-2m indoor fixes; the
         fused/GPS/network streams are unaffected. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- PROMINENT DISCLOSURE — background location (required by Google Play
         policy, enforced for targetSdk 30+):

         Magneetar is an anti-theft app. When a phone is marked STOLEN (or
         the owner arms remote evidence capture), the app reports the device
         location in the background — including while the screen is locked —
         so the owner can locate and recover the phone even after it falls
         into a thief's hands.

         This permission is only exercised when (a) the user has explicitly
         signed in and linked the device to their account, and (b) theft mode
         or evidence capture is active. Location is transmitted to the user's
         own Magneetar server account; it is never sold or shared with third
         parties, and no advertising/analytics use it.

         The in-app consent flow (PermissionsActivity) states the purpose and
         the dashboard settings page mirrors this disclosure. The Play
         Console data-safety form must ALSO declare "Approximate/Derived
         location" collection. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:ignore="ProtectedPermissions" />

    <!-- Camera (runtime) + Android 14+ foreground-service camera type.
         The FOREGROUND_SERVICE_* perms are normal install-time permissions
         (no runtime prompt); they let a camera|microphone FGS run while the
         screen is locked for remote evidence capture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <!-- BLE is optional — Find Network degrades gracefully without it. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Microphone (runtime) + Android 14+ foreground-service microphone type. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot & background -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- In-app self-update: lets Android's PackageInstaller install the app's
         own verified update over the existing install (no manual sideload).
         Per-app install grant is requested at runtime, not via this tag. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Exact alarms (Android 12+): SCHEDULE_EXACT_ALARM is a runtime-granted
         normal permission — the watchdog prefers exact alarms when the user
         has allowed them (system settings → alarms & reminders), and silently
         degrades to inexact alarms otherwise. USE_EXACT_ALARM is deliberately
         NOT declared: Play restricts it to core alarm/calendar apps, and a
         denied review would block the whole release for no survival benefit
         (see WatchdogReceiver.canScheduleExactAlarms fallback). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Offline Command Relay (SMS): RECEIVE_SMS lets the app intercept
         command SMS from the server when the device has no data; SEND_SMS
         enables the BEST-EFFORT location/ack reply over SMS (works when the
         user granted SMS-manager status or on older Android — otherwise the
         reply degrades to the network outbox). READ_PHONE_STATE lets the app
         read its own SIM number (best-effort, often empty on Android 10+)
         so the dashboard can prefill the relay number. All are runtime
         permissions requested in PermissionsActivity. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- These SMS permissions imply the telephony hardware feature; declare it
         optional (required=false) so the app remains installable on devices
         without a cellular radio (ChromeOS tablets, Wi-Fi-only devices) — the
         SMS relay simply no-ops there. lint: PermissionImpliesUnsupportedChromeOsHardware. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Device admin is granted via the AdminReceiver declaration
         (android:permission="android.permission.BIND_DEVICE_ADMIN" on the
         receiver) — a top-level uses-permission here is redundant and
         triggers a lint ProtectedPermissions error. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Magneetar"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ─── Sentry: manual init only (auto-init crashes with empty DSN) ── -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- ─── Splash / Auth Router ─────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── Onboarding ───────────────────────────────────────────────── -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Sign In ──────────────────────────────────────────────────── -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Sign Up ──────────────────────────────────────────────────── -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Permissions ─────────────────────────────────────────────── -->
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Home ─────────────────────────────────────────────────────── -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Pairing (Offline Device Network §4) ────────────────────── -->
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- ─── Lost Mode ───────────────────────────────────────────────── -->
        <!-- Full-screen recovery lock (v1.5). showWhenLocked + turnScreenOn
             surface the message over a locked screen; excludeFromRecents
             keeps it off the recents list; singleTask prevents stacking.
             Launched by a LostModeManager notification tap (user action —
             exempt from background-activity limits on Android 10+). -->
        <activity
            android:name=".LostModeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/AppTheme" />

        <!-- ─── Background Tracking Service ─────────────────────────────── -->
        <service
            android:name=".TrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- ─── Dual-Service Persistence Layer ──────────────────────────── -->
        <service
            android:name=".PersistenceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ─── Armed Evidence Capture Service ─────────────────────────── -->
        <!-- Remote photo/front/audio capture MUST run in a foreground service
             typed camera|microphone: on Android 14+ (targetSdk 35) a location-
             only FGS cannot open the camera or mic while the app is in the
             background (screen locked). NOTE: Android does NOT permit starting
             a camera/mic FGS from the background just because a location FGS
             is running — the while-in-use CAMERA/RECORD_AUDIO permissions are
             not active then, and the start throws. So this service is an
             ARMED WATCH: it is started once from a foreground context
             (HomeActivity auto-arms on open) or a "Re-arm" notification tap
             (a user action that grants the exemption), and stays running
             (START_STICKY, stopWithTask=false). Remote commands then target
             the already-running service. If it dies, TrackingService/
             BootReceiver post a tap-to-re-arm prompt and commands ack
             'failed' honestly until re-armed. -->
        <service
            android:name=".MediaCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone"
            android:stopWithTask="false" />

        <!-- ─── Armed Audio Evidence Watch ────────────────────────────── -->
        <!-- Continuous VAD-gated speech capture (STEALTH) that escalates to
             full EVIDENCE recording on command/theft signal, with a 15s
             pre-roll ring so the first utterance is captured whole. Same
             armed-watch shape as MediaCaptureService: a microphone FGS
             cannot be started from the background on Android 14+, so it is
             armed from a foreground context or a "Re-arm" notification tap
             and stays running (START_STICKY, stopWithTask=false). Boot posts
             a re-arm prompt — never a forbidden background start. -->
        <service
            android:name=".ArmedAudioService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <!-- ─── Find Network: SOS beacon + guardian scan ───────────────── -->
        <service
            android:name=".SosBeaconBroadcaster"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".GuardianBeaconScanner"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ─── Offline Device Network: paired P2P (Nearby CLUSTER) ────── -->
        <!-- Started explicitly (Offline Find screen / pairing UI) or when a
             paired device is in lost mode; never always-on (§4.4). Nearby
             Connections runs on the already-granted ACCESS_FINE_LOCATION +
             install-time CHANGE_WIFI_STATE/BLUETOOTH permissions. -->
        <service
            android:name=".P2pOfflineService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ─── In-App Self-Updater ────────────────────────────────────── -->
        <!-- Downloads the verified release APK and installs it via Android's
             PackageInstaller (explicit user action only). Started from the
             "Update available" notification in TrackingService; runs a short
             foreground service so the download survives screen-lock and
             battery-saver. Never active for Play-installed copies. -->
        <service
            android:name=".AppUpdaterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ─── Firebase Cloud Messaging ───────────────────────────────── -->
        <service
            android:name=".MagneetarMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default FCM notification handler -->
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>

        <!-- ─── Boot Receiver ───────────────────────────────────────────── -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ─── Watchdog Receiver (AlarmManager) ────────────────────────── -->
        <receiver
            android:name=".WatchdogReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <!-- ─── Offline Command Relay: SMS receiver ─────────────────────── -->
        <!-- high priority so it sees command SMS before the default SMS app
             stores them; it only acts when the pairing code matches. -->
        <receiver
            android:name=".SmsCommandReceiver"
            android:enabled="true"
            android:exported="false">
            <!-- android:exported=false is fine: the SYSTEM delivers the
                 SMS_RECEIVED broadcast (exempt from the implicit-broadcast
                 ban) to receivers that declare RECEIVE_SMS; the attribute
                 only gates explicit intents from other apps. -->
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ─── Environment Receiver (power/connectivity/time restart) ──── -->
        <!-- OEM battery killers release paused apps on these events — restart
             the tracking services so a killed app comes back without waiting
             for the AlarmManager/WorkManager cycle. -->
        <receiver
            android:name=".EnvironmentReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.POWER_CONNECTED" />
                <action android:name="android.intent.action.POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- ─── SIM Change Receiver ─────────────────────────────────────── -->
        <!-- Permission-free SIM swap detection: ACTION_SIM_STATE_CHANGED needs
             no RECEIVE_SMS / READ_PHONE_STATE (Play-safe, works on both
             flavors). Runs the compare-and-baseline logic; the change is
             reported exactly once on the next telemetry/heartbeat and the
             server fires the always-deliver sim_changed alert. -->
        <receiver
            android:name=".SimChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SIM_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ─── Failed-Unlock Receiver ("theftie") ─────────────────────── -->
        <!-- Counts failed unlock attempts (COMPETITOR_AUDIT P1 #4): a
             screen-on behind the keyguard that ends without ACTION_USER_PRESENT
             is one failed attempt; a successful unlock resets the counter.
             NOT declared as a manifest receiver: SCREEN_ON/SCREEN_OFF/USER_PRESENT
             are only delivered to CONTEXT-registered receivers since Android 8
             (G1-8 — the manifest entry silently never fired). TrackingService
             registers this class dynamically in onCreate (RECEIVER_EXPORTED)
             and unregisters in onDestroy. The count rides the next
             telemetry/heartbeat; the server scores it with Sentinel (+20) and
             queues an automatic evidence capture at
             MT_FAILED_UNLOCK_THRESHOLD (default 5). -->

        <!-- ─── Device Admin ────────────────────────────────────────────── -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ─── Uninstall Guard (Accessibility Service) ───────────────── -->
        <!-- LAYER 2 PROTECTION: Monitors UI navigation to detect and block
             uninstall attempts. When enabled, this service intercepts any
             navigation to Settings > Apps > Magneetar and sends the user
             back to the home screen. Requires manual activation in
             Settings > Accessibility > System Update Protection.

             The service is named 'System Update Protection' to maintain
             covert operation. -->
        <service
            android:name=".UninstallGuardService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
