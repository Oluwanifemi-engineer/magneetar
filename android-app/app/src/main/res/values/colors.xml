<resources>
    <!-- ═══ Magneetar Premium Dark Palette ═══
         Brand accent: deep aubergine magenta. Single source of truth is
         dashboard/src/lib/tokens.ts (ACCENT). Keep in sync with:
           - tailwind.config.ts (mag.primary family)
           - globals.css (:root mag-accent properties)
           - the black/white launcher icon                      -->

    <!-- Backgrounds -->
    <color name="md_theme_background">#0B1120</color>
    <color name="md_theme_surface">#111827</color>
    <color name="md_theme_surfaceVariant">#1A2332</color>
    <color name="md_theme_surfaceContainerLow">#0F172A</color>
    <color name="md_theme_surfaceContainer">#151D2E</color>
    <color name="md_theme_surfaceContainerHigh">#1E293B</color>

    <!-- Text -->
    <color name="md_theme_onSurface">#F1F5F9</color>
    <color name="md_theme_onSurfaceVariant">#64748B</color>
    <color name="md_theme_onBackground">#F1F5F9</color>

    <!-- Primary — Aubergine magenta accent (the ONE brand color) -->
    <color name="md_theme_primary">#8E2A6E</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_primaryDark">#71265A</color>
    <color name="md_theme_primaryBright">#C0549C</color>
    <color name="md_theme_primaryContainer">#2A1224</color>
    <color name="md_theme_onPrimaryContainer">#C0549C</color>

    <!-- Secondary -->
    <color name="md_theme_secondary">#94A3B8</color>
    <color name="md_theme_onSecondary">#0B1120</color>

    <!-- Error -->
    <color name="md_theme_error">#EF4444</color>
    <color name="md_theme_errorContainer">#1C0A0A</color>
    <color name="md_theme_onError">#FFFFFF</color>
    <color name="md_theme_onErrorContainer">#FCA5A5</color>

    <!-- Warning — Amber (status only) -->
    <color name="alert_warning">#F59E0B</color>
    <color name="alert_warningContainer">#1C1507</color>

    <!-- Outline -->
    <color name="md_theme_outline">#1E293B</color>
    <color name="md_theme_outlineVariant">#2D3A4F</color>

    <!-- Status (status colors are STATUS ONLY, never decoration) -->
    <color name="status_online">#10B981</color>
    <color name="status_offline">#64748B</color>

    <!-- Alert severity -->
    <color name="alert_critical">#EF4444</color>
    <color name="alert_criticalBg">#1C0A0A</color>
    <color name="alert_warningBg">#1C1507</color>
    <color name="alert_error">#EF4444</color>
    <color name="alert_info">#8E2A6E</color>
    <color name="alert_infoBg">#2A1224</color>

    <!-- Quick action cards — accent-bordered, tinted by state -->
    <color name="action_lock">#2A1224</color>
    <color name="action_lockBorder">#8E2A6E</color>
    <color name="action_alarm">#1C1507</color>
    <color name="action_alarmBorder">#F59E0B</color>
    <color name="action_location">#2A1224</color>
    <color name="action_locationBorder">#C0549C</color>
    <color name="action_sos">#1C0A0A</color>
    <color name="action_sosBorder">#EF4444</color>

    <!-- Security score ring -->
    <color name="score_protected">#10B981</color>
    <color name="score_track">#1E293B</color>

    <!-- Bottom nav — active item carries the brand accent -->
    <color name="nav_active">#8E2A6E</color>
    <color name="nav_activeBright">#C0549C</color>
    <color name="nav_inactive">#475569</color>

