<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════════════════
     Alerts tab — ported from design/stitch/07-alerts.png (Stitch approval).

     Structure per the design: title + critical counter, working filter
     chips (All / Security / Location — wired in AlertsFragment), alert
     cards with severity stripe + badge. Colors from tokens only.
     ══════════════════════════════════════════════════════════════════════ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with critical count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Activity"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_critical_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 critical"
                android:textColor="@color/alert_critical"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Filter chips (functional — see AlertsFragment.setFilter) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:background="@drawable/filter_active"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chip_security"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Security"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/filter_inactive"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chip_location"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Location"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/filter_inactive"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Alert list -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No alerts yet"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/layout_alert_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
