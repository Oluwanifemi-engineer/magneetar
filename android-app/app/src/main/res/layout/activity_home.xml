<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Minimal covert UI - looks like a system app -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Services"
        android:textColor="#F5F5F5"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Services Active"
        android:textColor="#00FF88"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="8dp" />

    <!-- Last sync time (subtle) -->
    <TextView
        android:id="@+id/tv_last_sync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#404040"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="24dp" />

    <!-- Device ID (very subtle - looks like a system identifier) -->
    <TextView
        android:id="@+id/tv_device_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#303030"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="32dp" />

    <!-- Minimal footer - hint for settings access -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.4.0"
        android:textColor="#202020"
        android:textSize="10sp"
        android:fontFamily="sans-serif" />

</LinearLayout>
