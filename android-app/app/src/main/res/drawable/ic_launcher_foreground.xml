<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      SHARP ANGULAR M LOGO — Geometric, fintech-style with crisp corners.

      This is a bold, architectural M with:
      - Sharp 90-degree corners (no curves)
      - Thick vertical pillars
      - Angular V-shape in the center
      - Clean, modern aesthetic

      The design uses pure straight lines (L commands) for maximum sharpness.
    -->

    <!-- Main M shape - sharp angular with thick pillars -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 28,76
            L 28,32
            L 38,32
            L 38,68
            L 54,44
            L 70,68
            L 70,32
            L 80,32
            L 80,76
            L 70,76
            L 70,56
            L 54,76
            L 38,56
            L 38,76
            Z
        " />

    <!-- Optional: Inner accent line for depth (thinner stroke effect) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:pathData="
            M 30,74
            L 30,34
            L 54,58
            L 78,34
            L 78,74
        " />
</vector>
