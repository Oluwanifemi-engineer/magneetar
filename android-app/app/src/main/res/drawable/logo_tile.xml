<?xml version="1.0" encoding="utf-8"?>
<!-- Branded logo tile: dark background with subtle white glow, used behind
     the white fused m/M mark in onboarding. Premium black-and-white theme. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow — subtle white -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
    <!-- Main tile — dark -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0f0f1a" />
        </shape>
    </item>
</layer-list>
