<?xml version="1.0" encoding="utf-8"?>
<!-- Battery-optimization attention card — amber-tinted surface with amber
     border, matching the Stitch Home design's attention state. Status
     color used as STATUS (attention needed), never decoration. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1C1507" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#3DF59E0B" />
</shape>
