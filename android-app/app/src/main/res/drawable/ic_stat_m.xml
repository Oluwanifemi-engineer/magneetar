<?xml version="1.0" encoding="utf-8"?>
<!--
     must be a single-color silhouette (launcher mipmaps render as a solid
     overlay in some OEM launchers) — the adaptive icon foreground is separate.
     Magneetar fused m/M-halves mark — white on transparent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Dark squircle background -->
    <path
        android:pathData="M12,0 L108,0 Q120,0 120,12 L120,108 Q120,120 108,120 L12,120 Q0,120 0,108 L0,12 Q0,0 12,0 Z"
        android:fillColor="#0f0f1a"/>

    <!-- Fused m/M-halves mark -->
    <path
        android:pathData="M29,90 L29,43 C29,25 68,25 68,43 L68,90 L91,29 L91,90"
        android:strokeWidth="12"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter"
        android:strokeMiterLimit="6"
        android:fillColor="#00000000"/>
</vector>
