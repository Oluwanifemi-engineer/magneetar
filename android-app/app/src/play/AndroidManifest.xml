<?xml version="1.0" encoding="utf-8"?>
<!-- ─── Play Store flavor overlay ────────────────────────────────────────────
     Google Play's SMS/Call-Log policy restricts RECEIVE_SMS/SEND_SMS to apps
     that are the default SMS handler or whose CORE functionality is SMS. The
     offline SMS command relay is a supporting anti-theft feature — neither
     category — so shipping it in the Play build risks rejection/appeal.

     This overlay strips the three restricted permissions (and their
     telephony feature) from the Play flavor only. The sideload flavor keeps
     them, so the APK on the download page retains the full offline relay.

     The app treats SMS as optional everywhere (denial never blocks
     onboarding; acks fall back to the network outbox), so removing the
     permissions requires no code changes.
─────────────────────────────────────────────────────────────────────────── -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.telephony"
        tools:node="remove" />

</manifest>
