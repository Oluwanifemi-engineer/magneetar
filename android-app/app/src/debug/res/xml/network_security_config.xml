<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: permit cleartext so developers can hit local/LAN
     self-hosted servers over plain http during development. The release
     build uses the strict config (res/xml/network_security_config.xml)
     which blocks cleartext except localhost/emulator. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
