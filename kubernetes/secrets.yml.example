# ═══════════════════════════════════════════════════════════════════════════════
# MAGNEETAR — Kubernetes Secrets TEMPLATE
# TEMPLATE ONLY — never holds real values, never applied directly. Copy to secrets.yml (gitignored), fill in real values, then: kubectl apply -f secrets.yml
# ═══════════════════════════════════════════════════════════════════════════════

apiVersion: v1
kind: Secret
metadata:
  name: magneetar-secrets
  namespace: magneetar
type: Opaque
stringData:
  # Database
  database-url: "postgresql://magneetar:CHANGE_ME@postgresql:5432/magneetar"
  postgres-user: "magneetar"
  postgres-password: "CHANGE_ME_TO_STRONG_PASSWORD"

  # API Keys (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
  api-key: "CHANGE_ME_MIN_32_CHARS_API_KEY_FOR_MASTER_ACCESS"
  device-key: "CHANGE_ME_MIN_32_CHARS_DEVICE_KEY_FOR_APK"
  jwt-secret: "CHANGE_ME_MIN_64_CHARS_JWT_SECRET_FOR_TOKEN_SIGNING"
  encryption-key: "CHANGE_ME_64_HEX_CHARS_ENCRYPTION_KEY"

  # External Services (optional - leave empty if not configured)
  sendgrid-key: ""
  twilio-sid: ""
  twilio-auth-token: ""
  twilio-sms-from: ""
  termii-key: ""

  # Monitoring (optional)
  sentry-dsn: ""

---
# Firebase Service Account (base64 encoded)
# Generate with: cat firebase-service-account.json | base64 -w 0
apiVersion: v1
kind: Secret
metadata:
  name: magneetar-firebase-key
  namespace: magneetar
type: Opaque
data:
  # Replace this with actual base64-encoded Firebase service account JSON
  firebase-service-account.json: "REPLACE_WITH_BASE64_ENCODED_FIREBASE_SERVICE_ACCOUNT_JSON"
